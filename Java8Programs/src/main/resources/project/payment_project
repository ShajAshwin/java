@Service
public class PaymentService {

    @CircuitBreaker(name = "paymentCB", fallbackMethod = "fallbackPayment")
    @Retry(name = "paymentRetry")
    @Timeout(name = "paymentTimeout", fallbackMethod = "fallbackPayment")
    public String processPayment() {
        // Simulate calling external payment API
        ResponseEntity<String> response = new RestTemplate().getForEntity("http://localhost:8081/gateway", String.class);
        return response.getBody();
    }

    public String fallbackPayment(Throwable t) {
        // Log to Splunk simulation
        System.out.println("Fallback triggered: " + t.getMessage());
        return "Payment processing delayed. Please try again.";
    }
}
